pipeline {
  agent any

  environment {
    HOST_REPO_ROOT = "${env.HOST_REPO_DIR ?: '/home/moyagoub/local-ai-devops-workstation'}"
    K3S_NAME      = 'lab03-k3s'
    IMAGE_TAG     = 'devops-lab-api:v1.0.0'
    HOST_REPO_DIR = '${HOST_REPO_ROOT}'
    KUBECONFIG    = '/tmp/lab03-kubeconfig'
  }

  stages {
    stage('Trivy Kubernetes Security Scan') {
      steps {
        sh '''
          set -e
          docker run --rm \
            -v "${HOST_REPO_DIR}/lab-03-kubernetes-kind/k8s:/k8s:ro" \
            ghcr.io/aquasecurity/trivy:latest config --severity HIGH,CRITICAL --exit-code 1 /k8s
        '''
      }
    }

    stage('Build Container Image') {
      steps {
        sh '''
          set -e
          docker build -t "${IMAGE_TAG}" "${WORKSPACE}/starter-lab"
        '''
      }
    }

    stage('Start K3s Cluster & Import Image') {
      steps {
        sh '''
          set -e
          docker rm -f "${K3S_NAME}" || true
          docker run -d --name "${K3S_NAME}" --privileged \
            local-k3s-node:v1.31.2 \
            server --snapshotter=native --disable=traefik --disable=servicelb --disable=coredns --pause-image=registry.k8s.io/pause:3.10

          # Wait for K3s to generate kubeconfig
          for i in $(seq 1 20); do
            if docker exec "${K3S_NAME}" test -f /etc/rancher/k3s/k3s.yaml; then
              break
            fi
            sleep 2
          done

          docker cp "${K3S_NAME}:/etc/rancher/k3s/k3s.yaml" "${KUBECONFIG}"
          K3S_IP=$(docker inspect -f '{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "${K3S_NAME}")
          sed -i "s|https://127.0.0.1:6443|https://${K3S_IP}:6443|g" "${KUBECONFIG}"

          # Wait for Kubernetes API node to become Ready
          for i in $(seq 1 20); do
            if kubectl --kubeconfig="${KUBECONFIG}" get nodes | grep -q " Ready"; then
              echo "K3s node is Ready!"
              break
            fi
            sleep 3
          done

          # Import local Docker image directly into K3s containerd
          docker save "${IMAGE_TAG}" | docker exec -i "${K3S_NAME}" k3s ctr images import -
        '''
      }
    }

    stage('Deploy Manifests & Verify Rollout') {
      steps {
        sh '''
          set -e
          kubectl --kubeconfig="${KUBECONFIG}" apply -f "${WORKSPACE}/lab-03-kubernetes-kind/k8s/namespace.yaml"
          kubectl --kubeconfig="${KUBECONFIG}" apply -f "${WORKSPACE}/lab-03-kubernetes-kind/k8s/"
          kubectl --kubeconfig="${KUBECONFIG}" -n devops-lab rollout status deployment/devops-lab-api --timeout=90s
          kubectl --kubeconfig="${KUBECONFIG}" -n devops-lab get pods,svc -o wide

          POD_IP=$(kubectl --kubeconfig="${KUBECONFIG}" -n devops-lab get pods -l app=devops-lab-api -o jsonpath='{.items[0].status.podIP}')
          docker exec "${K3S_NAME}" curl -sf "http://${POD_IP}:8080/health" || \
            kubectl --kubeconfig="${KUBECONFIG}" -n devops-lab get events --sort-by='.lastTimestamp' 
        '''
      }
    }
  }

  post {
    always {
      sh '''
        docker rm -f "${K3S_NAME}" || true
        rm -f "${KUBECONFIG}" || true
      '''
      cleanWs()
    }
  }
}
