pipeline {
  agent any

  stages {
    stage('Validate Prometheus Config & Alert Rules') {
      steps {
        sh '''
          set -e
          REPO_ROOT=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace/local-ai-devops-workstation"}}{{.Source}}{{end}}{{end}}' jenkins-local)
          docker run --rm --entrypoint /bin/promtool \
            -v "${REPO_ROOT}/lab-06-prometheus-grafana/prometheus:/etc/prometheus:ro" \
            quay.io/prometheus/prometheus:v2.55.1 \
            check config /etc/prometheus/prometheus.yml
        '''
      }
    }

    stage('Build & Start Observability Stack') {
      steps {
        sh '''
          set -e
          REPO_ROOT=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace/local-ai-devops-workstation"}}{{.Source}}{{end}}{{end}}' jenkins-local)
          docker network disconnect lab06-monitoring jenkins-local || true
          docker rm -f observability-api node-exporter prometheus grafana || true
          docker network rm lab06-monitoring || true

          docker network create lab06-monitoring
          docker network connect lab06-monitoring jenkins-local

          # 1. Build & start instrumented Flask API
          docker build -t lab06-observability-api:local "${WORKSPACE}/lab-06-prometheus-grafana/app"
          docker run -d --name observability-api --network lab06-monitoring lab06-observability-api:local

          # 2. Start Node Exporter
          docker run -d --name node-exporter --network lab06-monitoring quay.io/prometheus/node-exporter:v1.8.2

          # 3. Start Prometheus
          docker run -d --name prometheus --network lab06-monitoring \
            -v "${REPO_ROOT}/lab-06-prometheus-grafana/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro" \
            -v "${REPO_ROOT}/lab-06-prometheus-grafana/prometheus/alert-rules.yml:/etc/prometheus/alert-rules.yml:ro" \
            quay.io/prometheus/prometheus:v2.55.1

          # 4. Start Grafana with auto-provisioned Prometheus datasource
          docker run -d --name grafana --network lab06-monitoring \
            -e GF_SECURITY_ADMIN_USER=admin \
            -e GF_SECURITY_ADMIN_PASSWORD=admin \
            -v "${REPO_ROOT}/lab-06-prometheus-grafana/grafana/provisioning:/etc/grafana/provisioning:ro" \
            public.ecr.aws/ubuntu/grafana:latest

          sleep 8
        '''
      }
    }

    stage('Verify Prometheus Targets & Grafana API') {
      steps {
        sh '''
          set -e
          REPO_ROOT=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace/local-ai-devops-workstation"}}{{.Source}}{{end}}{{end}}' jenkins-local)
          echo "=== 1. Generating Traffic & Reading Metrics on Instrumented API ==="
          curl -sf "http://observability-api:8080/health"
          curl -sf "http://observability-api:8080/metrics"

          echo "=== 2. Verifying Prometheus Active Scrape Targets ==="
          TARGETS=$(curl -sf "http://prometheus:9090/api/v1/targets")
          echo "$TARGETS" | grep -q '"health":"up"'
          echo "Prometheus targets verified UP!"

          echo "=== 3. Verifying Grafana Health & Provisioned Datasource ==="
          curl -sf "http://grafana:3000/api/health"
          curl -sf -u admin:admin "http://grafana:3000/api/datasources" | grep -q "Prometheus"
          echo "Grafana Prometheus datasource verified!"
        '''
      }
    }
  }

  post {
    always {
      sh '''
        docker network disconnect lab06-monitoring jenkins-local || true
        docker rm -f observability-api node-exporter prometheus grafana || true
        docker network rm lab06-monitoring || true
      '''
      cleanWs()
    }
  }
}
