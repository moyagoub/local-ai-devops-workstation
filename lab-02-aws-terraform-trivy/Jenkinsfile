pipeline {
  agent any

  environment {
    TF_IN_AUTOMATION = 'true'
    HOST_TF_DIR = '/home/moyagoub/local-ai-devops-workstation/lab-02-aws-terraform-trivy/terraform'
  }

  stages {
    stage('Trivy IaC Security Scan') {
      steps {
        sh '''
          set -e
          docker run --rm \
            -v "${HOST_TF_DIR}:/src:ro" \
            ghcr.io/aquasecurity/trivy:latest config --severity HIGH,CRITICAL --exit-code 1 /src
        '''
      }
    }

    stage('Start LocalStack AWS Emulator') {
      steps {
        sh '''
          set -e
          docker rm -f localstack-lab02 || true
          docker network create lab02-net || true
          docker run -d --name localstack-lab02 \
            --network lab02-net \
            -e SERVICES=s3,iam,sts \
            public.ecr.aws/localstack/localstack:latest

          for i in $(seq 1 15); do
            if docker exec localstack-lab02 curl -sf http://localhost:4566/_localstack/health; then
              echo "LocalStack is healthy!"
              break
            fi
            echo "Waiting for LocalStack ($i/15)..."
            sleep 2
          done
        '''
      }
    }

    stage('Terraform Init, Plan & Apply') {
      steps {
        sh '''
          set -e
          docker run --rm --network lab02-net -v "${HOST_TF_DIR}:/infra" -w /infra \
            public.ecr.aws/hashicorp/terraform:1.9 init -input=false

          docker run --rm --network lab02-net -v "${HOST_TF_DIR}:/infra" -w /infra \
            public.ecr.aws/hashicorp/terraform:1.9 plan \
            -var="localstack_endpoint=http://localstack-lab02:4566" \
            -out=tfplan -input=false

          docker run --rm --network lab02-net -v "${HOST_TF_DIR}:/infra" -w /infra \
            public.ecr.aws/hashicorp/terraform:1.9 apply -auto-approve tfplan
        '''
      }
    }

    stage('Verify S3 Bucket in LocalStack') {
      steps {
        sh '''
          set -e
          docker run --rm --network lab02-net \
            -e AWS_ACCESS_KEY_ID=test \
            -e AWS_SECRET_ACCESS_KEY=test \
            -e AWS_DEFAULT_REGION=us-east-1 \
            public.ecr.aws/aws-cli/aws-cli:latest \
            --endpoint-url="http://localstack-lab02:4566" s3 ls
        '''
      }
    }
  }

  post {
    always {
      sh '''
        docker rm -f localstack-lab02 || true
        docker network rm lab02-net || true
      '''
      cleanWs()
    }
  }
}
