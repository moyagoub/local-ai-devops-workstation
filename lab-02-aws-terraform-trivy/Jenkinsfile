pipeline {
  agent any

  environment {
    TF_IN_AUTOMATION = 'true'
  }

  stages {
    stage('Trivy IaC Security Scan') {
      steps {
        sh '''
          set -e
          REPO_ROOT=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace/local-ai-devops-workstation"}}{{.Source}}{{end}}{{end}}' jenkins-local)
          docker run --rm \
            -v "${REPO_ROOT}/lab-02-aws-terraform-trivy/terraform:/src:ro" \
            ghcr.io/aquasecurity/trivy:latest config --severity HIGH,CRITICAL --exit-code 1 /src
        '''
      }
    }

    stage('Start LocalStack AWS Emulator') {
      steps {
        sh '''
          set -e
          REPO_ROOT=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace/local-ai-devops-workstation"}}{{.Source}}{{end}}{{end}}' jenkins-local)
          docker rm -f localstack-lab02 || true
          docker network create lab02-net || true
          docker run -d --name localstack-lab02 \
            --network lab02-net \
            -e SERVICES=s3,iam,sts,kms \
            public.ecr.aws/localstack/localstack:3.8.1
          sleep 5

          for i in $(seq 1 15); do
            if docker exec localstack-lab02 python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:4566/_localstack/health')"; then
              echo "LocalStack is healthy!"
              break
            fi
            echo "Waiting for LocalStack ($i/15)..."
            sleep 2
          done
        '''
      }
    }

    stage('Terraform Init, Plan & Apply') {
      steps {
        sh '''
          set -e
          REPO_ROOT=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace/local-ai-devops-workstation"}}{{.Source}}{{end}}{{end}}' jenkins-local)
          docker run --rm --network lab02-net -v "${REPO_ROOT}/lab-02-aws-terraform-trivy/terraform:/infra" -w /infra \
            -v "$(dirname "${REPO_ROOT}")/.terraform.d/plugin-cache:/plugin-cache" -e TF_PLUGIN_CACHE_DIR=/plugin-cache public.ecr.aws/hashicorp/terraform:1.9 init -input=false

          docker run --rm --network lab02-net -v "${REPO_ROOT}/lab-02-aws-terraform-trivy/terraform:/infra" -w /infra \
            -v "$(dirname "${REPO_ROOT}")/.terraform.d/plugin-cache:/plugin-cache" -e TF_PLUGIN_CACHE_DIR=/plugin-cache public.ecr.aws/hashicorp/terraform:1.9 plan \
            -var="localstack_endpoint=http://localstack-lab02:4566" \
            -out=tfplan -input=false

          docker run --rm --network lab02-net -v "${REPO_ROOT}/lab-02-aws-terraform-trivy/terraform:/infra" -w /infra \
            -v "$(dirname "${REPO_ROOT}")/.terraform.d/plugin-cache:/plugin-cache" -e TF_PLUGIN_CACHE_DIR=/plugin-cache public.ecr.aws/hashicorp/terraform:1.9 apply -auto-approve tfplan
        '''
      }
    }

    stage('Verify S3 Bucket in LocalStack') {
      steps {
        sh '''
          set -e
          REPO_ROOT=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace/local-ai-devops-workstation"}}{{.Source}}{{end}}{{end}}' jenkins-local)
          echo "=== 1. Listing S3 Buckets ==="
          docker run --rm --network lab02-net \
            -e AWS_ACCESS_KEY_ID=test -e AWS_SECRET_ACCESS_KEY=test -e AWS_DEFAULT_REGION=us-east-1 \
            public.ecr.aws/aws-cli/aws-cli:latest \
            --endpoint-url="http://localstack-lab02:4566" s3 ls

          echo "=== 2. Uploading & Listing Test Artifact ==="
          docker run --rm --network lab02-net \
            -e AWS_ACCESS_KEY_ID=test -e AWS_SECRET_ACCESS_KEY=test -e AWS_DEFAULT_REGION=us-east-1 \
            --entrypoint /bin/sh public.ecr.aws/aws-cli/aws-cli:latest -c \
            "echo 'build-verified' > /tmp/artifact.txt && aws --endpoint-url=http://localstack-lab02:4566 s3 cp /tmp/artifact.txt s3://legion7-devops-artifacts-lab02/artifact.txt && aws --endpoint-url=http://localstack-lab02:4566 s3 ls s3://legion7-devops-artifacts-lab02/"

          echo "=== 3. Verifying KMS Encryption Policy ==="
          docker run --rm --network lab02-net \
            -e AWS_ACCESS_KEY_ID=test -e AWS_SECRET_ACCESS_KEY=test -e AWS_DEFAULT_REGION=us-east-1 \
            public.ecr.aws/aws-cli/aws-cli:latest \
            --endpoint-url="http://localstack-lab02:4566" s3api get-bucket-encryption --bucket legion7-devops-artifacts-lab02
        '''
      }
    }
  }

  post {
    always {
      sh '''
        docker rm -f localstack-lab02 || true
        docker network rm lab02-net || true
      '''
      cleanWs()
    }
  }
}
