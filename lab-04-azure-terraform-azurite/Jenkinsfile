pipeline {
  agent any

  environment {
    TF_IN_AUTOMATION = 'true'
    HOST_TF_DIR      = '${HOST_REPO_DIR:-/home/moyagoub/local-ai-devops-workstation}/lab-04-azure-terraform-azurite/terraform'
    MCR_HOST         = 'mcr.microsoft.com'
    AZURITE_CONN     = 'DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite-lab04:10000/devstoreaccount1;'
  }

  stages {
    stage('Trivy Azure IaC Security Scan') {
      steps {
        sh '''
          set -e
          docker run --rm \
            -v "${HOST_TF_DIR}:/src:ro" \
            ghcr.io/aquasecurity/trivy:latest config --severity HIGH,CRITICAL --exit-code 1 /src
        '''
      }
    }

    stage('Terraform Format & Syntax Validate') {
      steps {
        sh '''
          set -e
          docker run --rm -v "${HOST_TF_DIR}:/infra" -w /infra \
            public.ecr.aws/hashicorp/terraform:1.9 fmt -check -diff

          docker run --rm -v "${HOST_TF_DIR}:/infra" -w /infra \
            public.ecr.aws/hashicorp/terraform:1.9 init -backend=false -input=false

          docker run --rm -v "${HOST_TF_DIR}:/infra" -w /infra \
            public.ecr.aws/hashicorp/terraform:1.9 validate
        '''
      }
    }

    stage('Start Azurite Emulator & Test Azure CLI') {
      steps {
        sh '''
          set -e
          AZURITE_IMG="${MCR_HOST}/azure-storage/azurite:latest"
          AZCLI_IMG="${MCR_HOST}/azure-cli:latest"

          docker rm -f azurite-lab04 || true
          docker network create lab04-net || true

          docker run -d --name azurite-lab04 \
            --network lab04-net \
            "${AZURITE_IMG}" \
            azurite-blob --blobHost 0.0.0.0 --blobPort 10000

          sleep 3

          echo "=== 1. Creating Azure Blob Container in Azurite ==="
          docker run --rm --network lab04-net \
            "${AZCLI_IMG}" \
            az storage container create \
              --name jenkins-artifacts \
              --connection-string "${AZURITE_CONN}"

          echo "=== 2. Uploading & Listing Build Artifact via Azure CLI ==="
          docker run --rm --network lab04-net \
            "${AZCLI_IMG}" \
            sh -c "echo 'azure-lab04-verified' > /tmp/azure-build.txt && \
                   az storage blob upload --container-name jenkins-artifacts --file /tmp/azure-build.txt --name azure-build.txt --connection-string '${AZURITE_CONN}' && \
                   az storage blob list --container-name jenkins-artifacts --connection-string '${AZURITE_CONN}' -o table"
        '''
      }
    }
  }

  post {
    always {
      sh '''
        docker rm -f azurite-lab04 || true
        docker network rm lab04-net || true
      '''
      cleanWs()
    }
  }
}
