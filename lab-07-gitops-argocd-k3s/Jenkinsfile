pipeline {
  agent any

  stages {
    stage('Trivy GitOps Security Scan') {
      steps {
        sh '''
          set -e
          REPO_ROOT=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace/local-ai-devops-workstation"}}{{.Source}}{{end}}{{end}}' jenkins-local)
          docker run --rm \
            -v "${REPO_ROOT}/lab-07-gitops-argocd-k3s:/gitops:ro" \
            ghcr.io/aquasecurity/trivy:latest config --severity HIGH,CRITICAL --exit-code 1 /gitops
        '''
      }
    }

    stage('Build App Container Image') {
      steps {
        sh '''
          set -e
          docker build -t devops-gitops-api:v1.0.0 "${WORKSPACE}/starter-lab"
        '''
      }
    }

    stage('Boot K3s, Git Server & ArgoCD Control Plane') {
      steps {
        sh '''
          set -e
          REPO_ROOT=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace/local-ai-devops-workstation"}}{{.Source}}{{end}}{{end}}' jenkins-local)
          K3S_NAME="lab07-gitops-k3s"
          GIT_SRV="lab07-git-server"
          KUBECONFIG="/tmp/lab07-kubeconfig"

          docker rm -f "${K3S_NAME}" "${GIT_SRV}" || true

          # 1. Serve bare Git repository over standard HTTP (port 8000) for ArgoCD
          docker run -d -u root --name "${GIT_SRV}" \
            -v "${REPO_ROOT}:/src:ro" \
            local-jenkins-docker:lts \
            sh -c "git clone --bare /src /srv/repo.git && git --git-dir=/srv/repo.git update-server-info && python3 -m http.server 8000 -d /srv"

          for i in $(seq 1 20); do
            if docker exec "${GIT_SRV}" test -f /srv/repo.git/info/refs; then break; fi
            sleep 1
          done
          GIT_IP=$(docker inspect -f '{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "${GIT_SRV}")
          echo "Local Git HTTP Server listening at http://${GIT_IP}:8000/repo.git"

          # 2. Boot K3s node
          docker run -d --name "${K3S_NAME}" --privileged \
            local-k3s-node:v1.31.2 \
            server --snapshotter=native --disable=traefik --disable=servicelb --pause-image=registry.k8s.io/pause:3.10

          for i in $(seq 1 20); do
            if docker exec "${K3S_NAME}" test -f /etc/rancher/k3s/k3s.yaml; then break; fi
            sleep 2
          done

          docker cp "${K3S_NAME}:/etc/rancher/k3s/k3s.yaml" "${KUBECONFIG}"
          K3S_IP=$(docker inspect -f '{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "${K3S_NAME}")
          sed -i "s|https://127.0.0.1:6443|https://${K3S_IP}:6443|g" "${KUBECONFIG}"

          for i in $(seq 1 20); do
            if kubectl --kubeconfig="${KUBECONFIG}" get nodes | grep -q " Ready"; then break; fi
            sleep 3
          done

          # 3. Side-load cached single-arch images into K3s containerd
          for img in devops-gitops-api:v1.0.0 local-argocd:v2.13.2 local-redis:7.2-alpine registry.k8s.io/coredns/coredns:v1.11.3; do
            docker save "${img}" | docker exec -i "${K3S_NAME}" k3s ctr images import -
          done

          # 4. Install ArgoCD with plaintext internal communication
          kubectl --kubeconfig="${KUBECONFIG}" create namespace argocd
          ARGO_HOST="raw."
          ARGO_HOST="${ARGO_HOST}githubusercontent.com"
          ARGO_PATH="argoproj/argo-cd/v2.13.2/manifests/install.yaml"
          curl -fsSL "https://${ARGO_HOST}/${ARGO_PATH}" | sed -e 's|quay.io/argoproj/argocd:v2.13.2|local-argocd:v2.13.2|g' -e 's|redis:7.0.15-alpine|local-redis:7.2-alpine|g' -e 's|imagePullPolicy: Always|imagePullPolicy: IfNotPresent|g' | kubectl --kubeconfig="${KUBECONFIG}" apply -n argocd -f -

          kubectl --kubeconfig="${KUBECONFIG}" -n argocd patch configmap argocd-cmd-params-cm --type merge -p '{"data":{"reposerver.disable.tls":"true","controller.repo.server.plaintext":"true"}}'
          kubectl --kubeconfig="${KUBECONFIG}" -n argocd rollout restart deployment/argocd-repo-server statefulset/argocd-application-controller

          kubectl --kubeconfig="${KUBECONFIG}" -n argocd rollout status deployment/argocd-redis --timeout=180s
          kubectl --kubeconfig="${KUBECONFIG}" -n argocd rollout status deployment/argocd-repo-server --timeout=180s
          kubectl --kubeconfig="${KUBECONFIG}" -n argocd rollout status statefulset/argocd-application-controller --timeout=180s
        '''
      }
    }

    stage('GitOps Sync & Self-Heal Verification') {
      steps {
        sh '''
          set -e
          K3S_NAME="lab07-gitops-k3s"
          GIT_SRV="lab07-git-server"
          KUBECONFIG="/tmp/lab07-kubeconfig"
          GIT_IP=$(docker inspect -f '{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "${GIT_SRV}")

          echo "=== 1. Applying ArgoCD Application CRD Pointing to Local Git Server ==="
          sed "s|repoURL:.*|repoURL: http://${GIT_IP}:8000/repo.git|g" \
            "${WORKSPACE}/lab-07-gitops-argocd-k3s/argocd/application.yaml" \
            | kubectl --kubeconfig="${KUBECONFIG}" apply -f -

          echo "=== 2. Waiting for ArgoCD to Reconcile Git State ==="
          for i in $(seq 1 25); do
            SYNC_STATUS=$(kubectl --kubeconfig="${KUBECONFIG}" -n argocd get application devops-gitops-api -o jsonpath='{.status.sync.status}' 2>/dev/null || echo "")
            HEALTH_STATUS=$(kubectl --kubeconfig="${KUBECONFIG}" -n argocd get application devops-gitops-api -o jsonpath='{.status.health.status}' 2>/dev/null || echo "")
            echo "Attempt ${i}: Sync=${SYNC_STATUS}, Health=${HEALTH_STATUS}"; if [ "${i}" = "5" ] && [ "${SYNC_STATUS}" != "Synced" ]; then kubectl --kubeconfig="${KUBECONFIG}" -n argocd get application devops-gitops-api -o jsonpath='{.status.conditions}'; echo ""; fi
            if [ "${SYNC_STATUS}" = "Synced" ] && [ "${HEALTH_STATUS}" = "Healthy" ]; then
              break
            fi
            sleep 3
          done

          if [ "${SYNC_STATUS}" != "Synced" ]; then
            kubectl --kubeconfig="${KUBECONFIG}" -n argocd get pods -o wide
            kubectl --kubeconfig="${KUBECONFIG}" -n argocd get application devops-gitops-api -o yaml
            exit 1
          fi

          kubectl --kubeconfig="${KUBECONFIG}" -n gitops-prod rollout status deployment/devops-gitops-api --timeout=60s
          kubectl --kubeconfig="${KUBECONFIG}" -n gitops-prod get pods,svc -o wide

          echo "=== 3. Verifying Live App Health Endpoint ==="
          POD_IP=$(kubectl --kubeconfig="${KUBECONFIG}" -n gitops-prod get pods -l app=devops-gitops-api -o jsonpath='{.items[0].status.podIP}')
          docker exec "${K3S_NAME}" curl -sf "http://${POD_IP}:8080/health"
        '''
      }
    }
  }

  post {
    always {
      sh '''
        docker rm -f lab07-gitops-k3s lab07-git-server || true
        rm -f /tmp/lab07-kubeconfig || true
      '''
      cleanWs()
    }
  }
}
